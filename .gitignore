# macOS
.DS_Store

# Obsidian merkt sich hier, welche Tabs gerade offen sind. Das gehört zum
# Rechner, nicht zur App - und würde sich bei jedem Klick ändern.
.obsidian/workspace.json
.obsidian/workspace-mobile.json

# Einstellungen der App: Leseposition, zuletzt geöffneter Text, Schalter.
# Ändert sich beim Scrollen. Beim Klonen greifen einfach die Vorgaben.
.obsidian/plugins/my-vault-app/data.json

# Testarchive für den Import. Lassen sich jederzeit neu packen.
Import-Test-*.zip

# Die gebaute Fassung. Entsteht bei jedem Release neu.
dist/

# Obsidians Papierkorb. Was hier landet, ist weggeworfen - eine Karte,
# die jemand aus der Lernkartei genommen hat. Im Repo waere es nur der
# Schatten geloeschter Dateien.
.trash/
